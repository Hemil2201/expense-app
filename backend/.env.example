# Copy to .env and fill in with your Supabase dev project's values
# (Supabase dashboard: Settings -> Database for DATABASE_URL, Settings -> API for the rest)

# Direct Postgres connection string, e.g.:
# postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local JWT signing secret for this app's own session tokens (independent of
# Supabase Auth — see backend/app/core/security.py). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# 1 year — this app only ever runs on Hemil's and Heenal's own phones, so a
# long-lived session beats building refresh/re-auth flows for no real gain.
JWT_EXPIRE_MINUTES=525600

# Statement parsing / categorization / receipt scanning (Slice 4) — blank is
# fine; PDF/messy-CSV statements fail to parse and categorization falls back
# to manual selection until this is set. Free tier at aistudio.google.com/apikey.
GEMINI_API_KEY=

ENV=dev
